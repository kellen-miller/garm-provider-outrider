  },
  "environment": {
    "clear_inherited": true,
    "reserved_prefix": "GARM_",
    "explicit": [
      "GARM_COMMAND",
      "GARM_CONTROLLER_ID",
      "GARM_PROVIDER_CONFIG_FILE",
      "GARM_INTERFACE_VERSION"
    ],
    "per_operation": [
      "GARM_POOL_ID",
      "GARM_INSTANCE_ID"
    ],
    "only_explicit_admin_allowlist_inherited": true,
    "preserve_controller_and_pool_identity": true
