[Unit]
Description=Outrider runner provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=outrider
Group=outrider
StateDirectory=outrider
StateDirectoryMode=0750
WorkingDirectory=/var/lib/outrider
ExecStart=/opt/outrider/bin/outrider serve --config /etc/outrider/config.toml
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/outrider

[Install]
WantedBy=multi-user.target
